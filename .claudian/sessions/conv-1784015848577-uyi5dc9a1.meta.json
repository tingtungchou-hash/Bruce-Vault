            targets.append((src, t, raw[:80]))\n\ndef resolve(t):\n    issues = []\n    t_orig = t\n    has_bs = chr(92) in t\n    t_clean = t.replace(chr(92), '/')\n    if has_bs:\n        issues.append('HAS_BACKSLASH')\n    t = t_clean.strip()\n    if not t:\n        issues.append('EMPTY_TARGET')\n        return issues, None\n    if t.endswith('/'):\n        if t[:-1] in all_dirs:\n            issues.append('DIRECTORY_LINK')\n        else:\n            issues.append('BROKEN_DIR')\n        return issues, None\n    if t in all_files:\n        return issues, t\n    if (t + '.md') in all_files:\n        issues.append('MISSING_MD')\n        return issues, t + '.md'\n    bn = Path(t).name\n    for af in all_files:\n        if Path(af).name == bn:\n            issues.append('BARE_NAME')\n            return issues, af\n        if Path(af).name == bn + '.md':\n            issues.append('BARE_NAME')\n            issues.append('MISSING_MD')\n            return issues, af\n    issues.append('BROKEN')\n    return issues, None\n\nunique = sorted(set(t[1] for t in targets))\n\nbroken = []; dir_links = []; has_bs = []; missing_md = []; bare_name = []; fine = 0\nissue_dist = {}\n\nfor t in unique:\n    issues, resolved = resolve(t)\n    if not issues:\n        fine += 1\n        continue\n    key = '+'.join(issues)\n    issue_dist[key] = issue_dist.get(key, 0) + 1\n    entry = (t, resolved, issues)\n    if 'BROKEN' in issues:\n        broken.append(entry)\n    elif 'BROKEN_DIR' in issues:\n        dir_links.append(entry)\n    elif 'HAS_BACKSLASH' in issues:\n        has_bs.append(entry)\n    elif 'MISSING_MD' in issues:\n        missing_md.append(entry)\n    elif 'BARE_NAME' in issues:\n        bare_name.append(entry)\n    elif 'DIRECTORY_LINK' in issues:\n        dir_links.append(entry)\n\ndef srcs(t):\n    return list(set(s[0] for s in targets if s[1].strip() == t.strip()))\n\nprint('='*70)\nprint('WIKILINK HEALTH REPORT')\nprint('='*70)\nprint()\nprint('Total wikilink occurrenc