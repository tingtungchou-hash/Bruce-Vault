{
	"nodes":[
		{"id":"7ead0f12202f00e2","type":"text","text":"The 3rd Declension","x":-1058,"y":408,"width":250,"height":60,"color":"#1f4e79"},
		{"id":"ee6891cb60d543f8","type":"text","text":"Labial & Velar Plosive Stems (==π β φ, κ γ χ==)","x":-600,"y":0,"width":250,"height":60,"color":"#2e75b6"},
		{"id":"e1d70b1f79952364","type":"text","text":"Dental Plosive Stems (==τ δ θ==)","x":-600,"y":189,"width":250,"height":60,"color":"#2e75b6"},
		{"id":"d2da67abdbb20269","type":"text","text":"Stems in ==-σ==","x":-600,"y":920,"width":250,"height":60,"color":"#2e75b6"},
		{"id":"c79909dd484fa03c","type":"text","text":"Masculine nouns in ==-ντ==","x":60,"y":110,"width":250,"height":60,"color":"#8faadc"},
		{"id":"5c206d0a376d04cd","type":"text","text":"Masculine & Feminine nouns in ==-ις== (-ας -υς ) ","x":60,"y":-640,"width":250,"height":60,"color":"#8faadc"},
		{"id":"f000000000000015","type":"text","text":"voc. sing. 无格尾（ἀσπί、χάρι）","x":980,"y":-470,"width":250,"height":90,"color":"#e53935"},
		{"id":"f000000000000013","type":"text","text":"短词干用于 nom. sing.、voc. sing.、dat. pl.，有时也用于 acc. sing.；长词干（见于 gen. sing.）用于其余各格","x":980,"y":-900,"width":250,"height":180,"color":"#ff8a80"},
		{"id":"f000000000000004","type":"text","text":"nom. sing. -ς；voc. sing. 无格尾；dat. pl. -σι(ν)；acc. sing. 为 -α 或 -ν","x":60,"y":276,"width":400,"height":90,"color":"#e53935"},
		{"id":"f000000000000005","type":"text","text":"非 i 元音词干（φυγάς 型，如 φυγάδ-）：nom./voc. sing. 与 dat. pl. 中齿音不出现，但 voc. sing. 作 -ς，acc. sing. 恒为短 -ᾰ","x":60,"y":396,"width":500,"height":110,"color":"#ff8a80"},
		{"id":"f00000000000000e","type":"text","text":"本为 -εσ- 词干：σ 在元音间脱落，余下的 ε 与格尾元音缩合；dat. pl. 中双 σ 变单 σ","x":60,"y":1584,"width":500,"height":90,"color":"#ff8a80"},
		{"id":"f00000000000000f","type":"text","text":"阳性：nom. sing. 的 -ης 是 -εσ- 的强元音形式；acc. pl. 与 nom. pl. 同形（Σωκράτεις），不用通常的 -ᾰς；voc. sing. 用纯词干 + recessive accent（Σώκρατες）","x":60,"y":1694,"width":500,"height":130,"color":"#e53935"},
		{"id":"f000000000000008","type":"text","text":"dat. pl.：词干末的 ν 不出现，且无补偿性延长（δαίμοσι）","x":60,"y":904,"width":500,"height":76,"color":"#ff8a80"},
		{"id":"f000000000000006","type":"text","text":"nom. sing. 与 voc. sing. 均无格尾；nom. sing. 用词干的强元音形式（ο → ω）：ῥήτωρ、δαίμων","x":60,"y":714,"width":500,"height":90,"color":"#ff8a80"},
		{"id":"89d8724b0f41f5d6","type":"text","text":"Neuter nouns in ==-τ==","x":60,"y":-200,"width":250,"height":60,"color":"#8faadc"},
		{"id":"f00000000000001a","type":"text","text":"重音：φῶς 的 φωτ- 按单音节词干处理（φωτός、φωτί、φωσί），但 gen. pl. 作 φώτων","x":980,"y":-170,"width":250,"height":152,"color":"#b71c1c"},
		{"id":"f00000000000001c","type":"text","text":"voc. sing.：脱去 ντ、保留弱元音；或与 nom. sing. 同形","x":980,"y":20,"width":250,"height":90,"color":"#ff8a80"},
		{"id":"f00000000000001d","type":"text","text":"dat. pl.：-ντσ- 简化为 -σ，前一元音同样补偿性延长（γέρουσι、γίγασι、ὀδοῦσι）","x":980,"y":130,"width":250,"height":100,"color":"#ff8a80"},
		{"id":"d5707a78d477306b","type":"text","text":"Nouns in a liquid or nasal (==λ, ρ, ν==) ","x":-600,"y":579,"width":250,"height":76,"color":"#2e75b6"},
		{"id":"a0150dcbe9d17265","type":"text","text":"Irregular stems in ==-ρ==  ","x":-600,"y":759,"width":250,"height":60,"color":"#2e75b6"},
		{"id":"f00000000000000b","type":"text","text":"voc. sing. 用 recessive accent（πάτερ、μῆτερ、θύγατερ、ἄνερ）；μήτηρ 与 θυγάτηρ 的 nom. sing. 亦然","x":60,"y":1170,"width":500,"height":90,"color":"#b71c1c"},
		{"id":"f00000000000000c","type":"text","text":"三音节形式的各格重音落在第二音节（πατέρα、πατέρες、πατέρων、πατράσι）","x":60,"y":1280,"width":500,"height":76,"color":"#b71c1c"},
		{"id":"f00000000000000d","type":"text","text":"ἀνήρ：除 nom. sing. 与 voc. sing. 外，各格在 ρ 前插入 δ（词干作 ἀνερ- / ἀνδρ-）","x":60,"y":1372,"width":500,"height":90,"color":"#ff8a80"},
		{"id":"f00000000000000a","type":"text","text":"词干有三种形式：强元音 -τηρ（仅 nom. sing.）、正常级 -τερ-、弱级 -τρ-（gen./dat. sing.）或 -τρᾰ-（dat. pl.）","x":60,"y":1040,"width":500,"height":110,"color":"#ff8a80"},
		{"id":"f000000000000019","type":"text","text":"dat. pl. 中 -τ- 不出现（πράγμασι、τέρασι）","x":980,"y":-276,"width":250,"height":76,"color":"#ff8a80"},
		{"id":"f000000000000003","type":"text","text":"acc. sing. 为 -α","x":980,"y":391,"width":250,"height":60,"color":"#e53935"},
		{"id":"48378163a95fa66f","type":"text","text":"特殊规则","x":1971,"y":118,"width":250,"height":60},
		{"id":"5a10f0e3feb11ad8","type":"text","text":"多种词尾","x":1562,"y":445,"width":250,"height":61},
		{"id":"f000000000000001","type":"text","text":"重音（单音节词干）：gen. 与 dat. 各数重音落在词尾——短 υ 用 acute、长 υ 用 circumflex；其余各格重音在第一（或唯一）音节","x":855,"y":506,"width":500,"height":110,"color":"#b71c1c"},
		{"id":"98536fbe845aa1c1","type":"text","text":"重音规则","x":1633,"y":978,"width":250,"height":60},
		{"id":"f000000000000014","type":"text","text":"acc. sing.：双音节重音在第二音节用长词干 + -α，重音在第一音节用短词干 + -ν","x":980,"y":-680,"width":250,"height":160,"color":"#ff8a80"},
		{"id":"550af70614afd8ae","x":1390,"y":-680,"width":250,"height":60,"type":"text","text":"多种词干"},
		{"id":"194722fd4efaceca","type":"text","text":"词干变形","x":1780,"y":-380,"width":250,"height":60},
		{"id":"dea9db0fa96b2d81","type":"text","text":"元音延长","x":1515,"y":5,"width":250,"height":60},
		{"id":"0c76d736c793c976","x":1437,"y":-350,"width":250,"height":60,"type":"text","text":"词干变形"}
	],
