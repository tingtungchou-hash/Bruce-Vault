	"nodes":[
		{"id":"7ead0f12202f00e2","type":"text","text":"The 3rd Declension","x":-1058,"y":408,"width":250,"height":60,"color":"#1f4e79"},
		{"id":"c79909dd484fa03c","type":"text","text":"Masculine nouns in ==-ντ==","x":60,"y":110,"width":250,"height":60,"color":"#8faadc"},
		{"id":"5c206d0a376d04cd","type":"text","text":"Masculine & Feminine nouns in ==-ις== (-ας -υς ) ","x":60,"y":-640,"width":250,"height":60,"color":"#8faadc"},
		{"id":"a000000000000000","type":"text","text":"规则","x":2200,"y":400,"width":250,"height":60,"color":"#1f4e79"},
		{"id":"a100000000000001","type":"text","text":"通用机制","x":1850,"y":-820,"width":250,"height":60,"color":"#548235"},
		{"id":"a200000000000101","type":"text","text":"词末限制: V / -ν / -ρ / -ς","x":1500,"y":-880,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a200000000000102","type":"text","text":"gen sg = 真词干 → 其余各格由它派生","x":1500,"y":-760,"width":250,"height":80,"color":"#a9d18e"},
		{"id":"a100000000000002","type":"text","text":"固定格尾（各名词相同）","x":1850,"y":-560,"width":250,"height":60,"color":"#548235"},
		{"id":"a200000000000201","type":"text","text":"gen sg -ος · dat sg -ι · nom pl -ες / -α · gen pl -ων · acc pl -ας / -α · du -ε / -οιν","x":1500,"y":-560,"width":250,"height":160,"color":"#a9d18e"},
		{"id":"a100000000000003","type":"text","text":"变动格位（仅 4 个）","x":1850,"y":-180,"width":250,"height":60,"color":"#548235"},
		{"id":"a200000000000301","type":"text","text":"nom sg","x":1500,"y":-380,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a300000000000311","type":"text","text":"默认: +ς","x":1150,"y":-440,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a300000000000312","type":"text","text":"∅: ντ 无-ς型 / 中性","x":1150,"y":-340,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a200000000000302","type":"text","text":"voc sg","x":1500,"y":-120,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a300000000000321","type":"text","text":"默认: ∅（= 词干去末 C）","x":1150,"y":-180,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a300000000000322","type":"text","text":"= nom sg: 唇软腭 / 齿音非i型 / ντ带ς型 / 中性","x":1150,"y":-80,"width":250,"height":100,"color":"#e2efda"},
		{"id":"a200000000000303","type":"text","text":"acc sg","x":1500,"y":140,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a300000000000331","type":"text","text":"默认: -α","x":1150,"y":80,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a300000000000332","type":"text","text":"-ν: 双音节 + ιτ/ιδ/ιθ + 首音节重音","x":1150,"y":180,"width":250,"height":80,"color":"#e2efda"},
		{"id":"a300000000000333","type":"text","text":"∅: 中性","x":1150,"y":300,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a200000000000304","type":"text","text":"dat pl: -σι(ν)","x":1500,"y":420,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a100000000000004","type":"text","text":"词干变形","x":1850,"y":900,"width":250,"height":60,"color":"#548235"},
		{"id":"a200000000000401","type":"text","text":"元音","x":1500,"y":760,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a300000000000411","type":"text","text":"强元音: ο → ω（ντ / 流音 nom sg）","x":1150,"y":700,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a300000000000412","type":"text","text":"缩合: -εσ- 词干 σ 脱落后 ε + 元音 → 缩合","x":1150,"y":800,"width":250,"height":96,"color":"#e2efda"},
		{"id":"a200000000000402","type":"text","text":"辅音","x":1500,"y":1020,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a300000000000421","type":"text","text":"C + ς → ψ（唇）/ ξ（软腭）","x":1150,"y":960,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a300000000000422","type":"text","text":"C → ∅: 齿音 τδθ / ν（流音）/ 中性 -τ","x":1150,"y":1060,"width":250,"height":80,"color":"#e2efda"},
		{"id":"a300000000000423","type":"text","text":"ντ + σ/ς → σ/ς + ¯V（补偿性延长）","x":1150,"y":1160,"width":250,"height":80,"color":"#e2efda"},
		{"id":"a200000000000403","type":"text","text":"多种词干","x":1500,"y":1340,"width":250,"height":60,"color":"#a9d18e"},
		{"id":"a300000000000431","type":"text","text":"-ις 型: 短词干（nom/voc sg, dat pl, 有时 acc sg）/ 长词干（其余）","x":1150,"y":1300,"width":250,"height":120,"color":"#e2efda"},
		{"id":"a300000000000432","type":"text","text":"πατήρ 型: τηρ（nom sg）/ τερ / τρ","x":1150,"y":1440,"width":250,"height":80,"color":"#e2efda"},
		{"id":"a300000000000433","type":"text","text":"ἀνήρ: ἀνερ- / ἀνδρ-","x":1150,"y":1560,"width":250,"height":60,"color":"#e2efda"},
		{"id":"a100000000000005","type":"text","text":"特殊重音","x":1850,"y":1760,"width":250,"height":60,"color":"#548235"},
		{"id":"a200000000000501","type":"text","text":"单音节词干: gen/dat 各数 → 词尾（短 υ: acute / 长 υ: circumflex）；其余 → 首音节","x":1500,"y":1700,"width":250,"height":120,"color":"#a9d18e"},
		{"id":"a200000000000502","type":"text","text":"recessive: voc sg 用纯词干重音；部分词 nom sg 亦然","x":1500,"y":1840,"width":250,"height":96,"color":"#a9d18e"},
